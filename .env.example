# AHM International — environment template
# ========================================
#
# Copy to `.env.local` for local development. Do not invent values to make the
# site look complete: unset variables stay unpublished in the UI on purpose.
#
# See LAUNCH.md for the full launch checklist.

# Canonical production origin (canonicals, sitemap, Open Graph, schema).
# NEXT_PUBLIC_SITE_URL=https://www.ahminternationals.com

# Public contact — published only when set. Use a company-domain address.
# NEXT_PUBLIC_SALES_EMAIL=info@ahminternationals.com
# NEXT_PUBLIC_PHONE=+92-21-00000000
# NEXT_PUBLIC_WHATSAPP=922100000000

# Social profiles — icons appear only when set.
# NEXT_PUBLIC_LINKEDIN=https://www.linkedin.com/company/example
# NEXT_PUBLIC_INSTAGRAM=https://www.instagram.com/example

# RFQ delivery by email through the info@ mailbox (Hostinger SMTP).
# SMTP_PASS is the only one required; set it in Vercel as Sensitive, never here.
# SMTP_PASS=
# SMTP_USER=info@ahminternationals.com        (defaults to NEXT_PUBLIC_SALES_EMAIL)
# SMTP_HOST=smtp.hostinger.com                 (default)
# SMTP_PORT=465                                (default)
# RFQ_NOTIFY_TO=                               (defaults to the mailbox itself)
# RFQ_SEND_ACKNOWLEDGEMENT=true                (also email the buyer a receipt)

# Optional extra destination for a CRM or automation tool.
# RFQ_WEBHOOK_URL=
# RFQ_WEBHOOK_TOKEN=

# Private file store and enquiry register (Vercel Blob, private). Created by
# Vercel when the store is connected to the project; nothing to type here.
# BLOB_READ_WRITE_TOKEN=
# RFQ_FILE_RETENTION_DAYS=730                  (files deleted this long after the enquiry; min 30)

# Enquiry register (/pipeline). Sign in with an emailed link (needs SMTP_PASS),
# or with a PIN, or both.
# PIPELINE_PIN=                                (4 to 12 digits; Sensitive; signs in as the first admin;
#                                               10 wrong attempts a day, then off until midnight UTC)
# PIPELINE_STAFF=info@ahminternationals.com:admin, someone@ahminternationals.com:sales
#                                              (roles: admin, sales, viewer; default: the mailbox as admin)
# PIPELINE_SECRET=                             (optional; defaults to a key derived from the store token)
# CRON_SECRET=                                 (optional; Vercel sends it to the daily job)

# Sourcing assistant. Off unless a key is set. Base URL is fixed to Anthropic's.
# ANTHROPIC_API_KEY=                           (console.anthropic.com; set a monthly spend limit there)
# ASSISTANT_MODEL=claude-opus-5-5              (or claude-sonnet-5-5 / claude-haiku-5-5 for a lower bill)
# ASSISTANT_ENABLED=false                      (switch off without removing the key)

# IndexNow (optional, after Search Console verification).
# INDEXNOW_KEY=
# INDEXNOW_SECRET=
